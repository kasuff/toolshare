{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    // The mobile workspace pulls in @types/react@19, which npm hoists to the
    // repo-root node_modules. When the frontend is built as part of a root
    // `npm ci` (e.g. the prod Docker image), tsc would otherwise resolve BOTH
    // that hoisted v19 and the frontend's own @types/react@18 -> incompatible
    // React/JSX types (TS2786 "cannot be used as a JSX component"). Pin React
    // type resolution to the frontend's own v18 copy.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src"],
  "exclude": ["src/tests"]
}
