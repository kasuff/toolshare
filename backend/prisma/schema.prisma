generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  MANAGER
}

enum ToolStatus {
  AVAILABLE
  REQUESTED
  BORROWED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  RETURNED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ReportTargetType {
  TOOL
  WORKSHOP
  USER
  RATING
}

enum RatingStatus {
  VISIBLE
  HIDDEN
}

enum SuspensionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PickupProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  address       String
  latitude      Float?
  longitude     Float?
  role          Role           @default(USER)
  isSuspended   Boolean        @default(false)
  expoPushToken String?
  createdAt     DateTime       @default(now())
  tools         Tool[]
  bookings      Booking[]
  workshops     Workshop[]
  notifications Notification[]
  reports       Report[]       @relation("ReporterReports")
  ratingsGiven  Rating[]       @relation("RatingsGiven")
  ratingsReceived Rating[]     @relation("RatingsReceived")
  pickupProposalsAuthored BookingPickupProposal[] @relation("PickupProposalAuthor")
  suspensionRequestsReceived SuspensionRequest[] @relation("SuspensionTarget")
  suspensionRequestsMade     SuspensionRequest[] @relation("SuspensionRequester")
  timeslotProposalsAuthored BookingTimeslotProposal[] @relation("TimeslotProposalAuthor")
  refreshTokens RefreshToken[]
}

// Serverseitig nachgehaltene Refresh-Tokens. Es wird nur der SHA-256-Hash des
// Tokens gespeichert (nie das Token selbst), sodass ein DB-Leak keine gültigen
// Tokens preisgibt. Ermöglicht echtes Logout, Rotation und Sperrung vor Ablauf.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  // Unterstützt das künftige Aufräumen abgelaufener Tokens.
  @@index([expiresAt])
}

model Tool {
  id          String     @id @default(uuid())
  ownerId     String
  name        String
  description String
  category    String
  imageUrl    String?
  pickupLocation String?
  pickupLocationNote String?
  pickupLat   Float?
  pickupLon   Float?
  status      ToolStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  // ownerId = "Meine Werkzeuge"/Besitzabfragen; status/category = Filter in der Suche.
  @@index([ownerId])
  @@index([status])
  @@index([category])
}

model Workshop {
  id          String     @id @default(uuid())
  managerId   String
  name        String
  description String
  location    String
  latitude    Float?
  longitude   Float?
  maxCapacity Int
  equipment   String[]   @default([])
  imageUrls   String[]   @default([])
  manager     User       @relation(fields: [managerId], references: [id], onDelete: Cascade)
  workshopTools WorkshopTool[]
  timeslots   TimeSlot[]
  bookings    Booking[]
}

model WorkshopTool {
  id         String   @id @default(uuid())
  workshopId String
  name       String
  category   String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  selectedInBookings BookingSelectedTool[]

  @@index([workshopId])
  @@index([category])
}

model TimeSlot {
  id         String    @id @default(uuid())
  workshopId String
  startTime  DateTime
  endTime    DateTime
  blockedByOwner Boolean @default(false)
  workshop   Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  bookings   Booking[]
}

model Booking {
  id         String        @id @default(uuid())
  userId     String
  toolId     String?
  timeslotId String?
  workshopId String?
  status     BookingStatus @default(PENDING)
    startDate  DateTime
    endDate    DateTime
    pickupTime DateTime?
    createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool       Tool?         @relation(fields: [toolId], references: [id], onDelete: SetNull)
  timeslot   TimeSlot?     @relation(fields: [timeslotId], references: [id], onDelete: SetNull)
  workshop   Workshop?     @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  reports    Report[]
  ratings    Rating[]
  selectedTools BookingSelectedTool[]
  pickupProposals BookingPickupProposal[]
  timeslotProposals BookingTimeslotProposal[]

  @@index([toolId, startDate, endDate])
  @@index([timeslotId])
  @@index([workshopId, startDate, endDate])
}

model BookingSelectedTool {
  bookingId       String
  workshopToolId  String
  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  workshopTool    WorkshopTool @relation(fields: [workshopToolId], references: [id], onDelete: Cascade)

  @@id([bookingId, workshopToolId])
  @@index([workshopToolId])
}

model BookingPickupProposal {
  id                 String               @id @default(uuid())
  bookingId          String
    proposedByUserId   String
    proposedPickupTime DateTime
    proposedReturnTime DateTime?
    previousPickupTime DateTime?
    previousReturnTime DateTime?
  status             PickupProposalStatus @default(PENDING)
  createdAt          DateTime             @default(now())
  booking            Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proposedBy         User                 @relation("PickupProposalAuthor", fields: [proposedByUserId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model BookingTimeslotProposal {
  id                 String               @id @default(uuid())
  bookingId          String
  proposedByUserId   String
  proposedStartDate  DateTime
  proposedEndDate    DateTime
  previousStartDate  DateTime?
  previousEndDate    DateTime?
  status             PickupProposalStatus @default(PENDING)
  createdAt          DateTime             @default(now())
  booking            Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proposedBy         User                 @relation("TimeslotProposalAuthor", fields: [proposedByUserId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Rating {
  id           String       @id @default(uuid())
  bookingId    String
  fromUserId   String
  toUserId     String
  score        Int
  comment      String?
  status       RatingStatus @default(VISIBLE)
  moderatorId  String?
  decisionNote String?
  moderatedAt  DateTime?
  createdAt    DateTime     @default(now())
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUser     User         @relation("RatingsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User         @relation("RatingsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([bookingId, fromUserId, toUserId])
  @@index([toUserId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Deckt listByUser ab: Filter userId + Sortierung createdAt desc.
  @@index([userId, createdAt])
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  bookingId    String?
  reason       String
  details      String?
  conversationContext String?
  status       ReportStatus @default(OPEN)
  moderatorId  String?
  decisionNote String?
  decisionAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reporter     User         @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  suspensionRequests SuspensionRequest[]

  @@index([targetType, targetId])
}

model SuspensionRequest {
  id            String                  @id @default(uuid())
  userId        String
  requestedById String
  reportId      String?
  reason        String
  status        SuspensionRequestStatus @default(PENDING)
  adminId       String?
  decisionNote  String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  user          User                    @relation("SuspensionTarget", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy   User                    @relation("SuspensionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  report        Report?                 @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}

model SystemSetting {
  key       String   @id
  value     Int
  updatedAt DateTime @updatedAt
}

/// Transactional Outbox — Domain Events werden atomar mit Business-Daten geschrieben.
model OutboxEvent {
  id             String    @id @default(uuid())
  eventType      String
  payload        Json
  idempotencyKey String    @unique
  aggregateType  String?
  aggregateId    String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?
  retryCount     Int       @default(0)
  lastError      String?

  @@index([processedAt, createdAt])
}

/// Idempotenz-Nachweis für at-least-once Zustellung (Push/In-App).
model NotificationDelivery {
  idempotencyKey String   @id
  processedAt    DateTime @default(now())
}
