PORT=4000
DATABASE_URL=postgresql://toolshare:toolshare@localhost:5432/toolshare
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Kommagetrennt; * = alle Origins (nur Entwicklung)
CORS_ORIGIN=http://localhost:3000
# Rate limits (Fenster in ms) — 600 Requests pro Minute pro Nutzer
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=50
