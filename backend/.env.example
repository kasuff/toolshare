PORT=4000
DATABASE_URL=postgresql://toolshare:toolshare@localhost:5432/toolshare
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Kommagetrennt; * = alle Origins (nur Entwicklung)
CORS_ORIGIN=http://localhost:3000
# Rate limits (Fenster in ms) — 600 Requests pro Minute pro Nutzer
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=50
# Geocoding cache (optional Redis — defaults to in-memory if CACHE_BACKEND=memory)
REDIS_URL=redis://localhost:6379
CACHE_BACKEND=memory
GEOCODING_CACHE_TTL_SECONDS=86400

# Image storage (default: dataurl — same as MVP; set r2 for Cloudflare R2)
STORAGE_BACKEND=dataurl
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=toolshare-images
# R2_PUBLIC_URL=https://images.example.com
NOMINATIM_MIN_INTERVAL_MS=1000
# Kommagetrennte E-Mail-Adressen, die die Manager-Rolle erhalten dürfen
MANAGER_EMAIL_ALLOWLIST="user1@example.com,user2@example.com"
